# Copy this file to ".env" and fill in what you want. Everything here is optional.
# The app runs fine with no .env at all (AI "go deeper" just falls back to a simple template).

# --- Opt-in AI ("go deeper" follow-up questions) ---
# Provide ONE of these to enable real AI follow-ups. Leave blank to use the built-in
# rule-based templates (no entry text ever leaves your machine).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model to use (optional). Defaults below are reasonable starting points; change if needed.
ANTHROPIC_MODEL=claude-3-5-haiku-latest
OPENAI_MODEL=gpt-4o-mini

# --- App ---
# A random secret is generated automatically on first run if you leave this blank.
SECRET_KEY=

# Public origin the app is served from (your Tailscale name). Used for push + PWA.
# Example: https://desktop.tailXXXX.ts.net  -- leave blank for local testing.
PUBLIC_ORIGIN=

# Email used as the VAPID contact for web push (any email is fine).
VAPID_CONTACT=mailto:megkelle@gmail.com
